{
  "name": "watermelon-ui-kit",
  "version": "1.5.10",
  "type": "module",
  "main": "./dist/watermelon-ui-kit.umd.js",
  "module": "./dist/watermelon-ui-kit.es.js",
  "types": "./dist/components/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/watermelon-ui-kit.es.js",
      "require": "./dist/watermelon-ui-kit.umd.js"
    },
    "./styles": "./dist/watermelon-ui-kit.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.lib.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "type-check": "vue-tsc --noEmit",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.5.1",
    "@primevue/themes": "^4.5.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-onboarding": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "10.6.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "primeicons": "^8.0.2",
    "primevue": "^4.5.4",
    "sass-embedded": "^1.105.2",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/avesheva/watermelon-ui-kit.git"
  }
}
